#!/bin/sh
# TrimUI stock firmware runs /mnt/SDCARD/.tmp_update/updater at boot when it
# exists, in place of its own MainUI. This brings the Brick / Brick Pro up the
# way slot expects, then runs slot until it powers the device off itself.

SD="${SLOT_ROOT:-/mnt/SDCARD}"
SYS="$SD/System"
export SLOT_ROOT="$SD"

log() {
	echo "$(date '+%H:%M:%S') $*" >> "$SD/slot-session.log" 2>/dev/null
}

model="$(strings /usr/trimui/bin/MainUI 2>/dev/null | grep '^Trimui' | head -n 1)"
case "$model" in
"Trimui Brick Pro") device=brickpro ;;
"Trimui Brick") device=brick ;;
"Trimui Smart Pro") device=smartpro ;;
*)
	case "$(cat /proc/cpuinfo 2>/dev/null)" in
	*TG4040*) device=brickpro ;;
	*TG3040*) device=brick ;;
	*) device=smartpro ;;
	esac
	;;
esac
export SLOT_DEVICE="${SLOT_DEVICE:-$device}"
export SLOT_KEYMAP="${SLOT_KEYMAP:-trimui}"
log "boot on $model ($SLOT_DEVICE)"

export LD_LIBRARY_PATH="/usr/trimui/lib:/usr/lib:$LD_LIBRARY_PATH"
export PATH="/usr/trimui/bin:$PATH"

gpio_out() {
	[ -d "/sys/class/gpio/gpio$1" ] || echo "$1" > /sys/class/gpio/export 2>/dev/null
	echo -n out > "/sys/class/gpio/gpio$1/direction" 2>/dev/null
	echo -n "$2" > "/sys/class/gpio/gpio$1/value" 2>/dev/null
}

# PD11 high powers the 5V rail the pad and speaker amp hang off
gpio_out 107 1
# PH3 drives the rumble motor, idle until slot asks for it
gpio_out 227 0

# every light off until slot picks a state for the top bar
for scale in max_scale max_scale_lr max_scale_f1f2 max_scale_rear; do
	echo 0 > "/sys/class/led_anim/$scale" 2>/dev/null
done

# slot scales samples itself, so open the codec all the way up once
amixer -q sset 'DAC volume' 160 2>/dev/null
amixer -q sset 'digital volume' 0 2>/dev/null
echo 0 > /sys/class/speaker/mute 2>/dev/null

# the stock pad is a serial device that trimui_inputd turns into evdev
pidof trimui_inputd > /dev/null 2>&1 || trimui_inputd > /dev/null 2>&1 &

governor=/sys/devices/system/cpu/cpu0/cpufreq
echo ondemand > "$governor/scaling_governor" 2>/dev/null
echo 1008000 > "$governor/scaling_min_freq" 2>/dev/null

cd "$SYS" || exit 1

crashes=0
while :; do
	[ -f "$SD/slot.log" ] && mv -f "$SD/slot.log" "$SD/slot.log.1"
	log "exec $SYS/slot"
	began="$(date +%s)"
	/lib/ld-linux-aarch64.so.1 "$SYS/slot" > "$SD/slot.log" 2>&1
	status=$?
	log "slot exited $status"
	sync
	# a run that lasted a minute was not a boot loop
	[ $(($(date +%s) - began)) -ge 60 ] && crashes=0
	crashes=$((crashes + 1))
	if [ "$crashes" -ge 3 ]; then
		log "slot keeps exiting, powering off"
		break
	fi
	sleep 1
done

killall trimui_inputd 2>/dev/null
# never fall through to stock, it would rescan and rewrite this card
poweroff
while :; do sleep 1; done
